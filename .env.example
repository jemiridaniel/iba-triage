# Copy to .env and fill in. Never commit .env.
# Keep comments on their own lines (some env loaders don't strip inline comments).

# --- Nebius Token Factory (OpenAI-compatible) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# --- Model IDs ---
# Never hard-code these in code. Get the real IDs with:
#   uv run python -m scripts.list_models
# Nemotron 3 Nano: intake, outbreak extraction (use for all dev work)
MODEL_FAST=
# Nemotron 3 Super: compose / referral note
MODEL_MID=
# Nemotron 3 Ultra (or Super as fallback): reason step only
MODEL_REASON=
# Embedding model for the guideline index
MODEL_EMBED=

# USD per 1M tokens, keyed by model ID (JSON). REQUIRED for live calls: the spend guard
# refuses any call to a model without a price. Copy the generated line below.
MODEL_PRICES={}
# >>> MODEL_PRICES (generated by `scripts/list_models.py --write-prices`)
# USD per 1M tokens from GET /v1/models?verbose=true. Copy into .env (uncommented).
# MODEL_PRICES={"nvidia/nemotron-3-super-120b-a12b": {"input": 0.3, "output": 0.9}, "nvidia/Nemotron-3-Ultra-550b-a55b": {"input": 1.0, "output": 3.0}, "nvidia/Nemotron-3_5-Lightning": {"input": 0.06, "output": 0.24}, "nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B": {"input": 0.06, "output": 0.24}, "Qwen/Qwen3-Embedding-8B": {"input": 0.01, "output": 0.0}}
# <<< MODEL_PRICES

# --- Tavily ---
TAVILY_API_KEY=

# --- App ---
# dev | prod  (prod: disk cache off by default)
APP_ENV=dev
CACHE_DIR=.cache
# Defaults to true in dev, false in prod
# CACHE_ENABLED=true
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
# Sent on every call so each call's worst-case cost is bounded
LLM_DEFAULT_MAX_TOKENS=2048
# Per-step reasoning (off = chat_template_kwargs enable_thinking=false; /no_think is ignored)
REASONING_INTAKE=false
REASONING_OUTBREAK=false
REASONING_REASON=true
REASONING_COMPOSE=false
# Completion budgets per step; reasoning tokens count toward max_tokens
MAX_TOKENS_REASONING_OFF=1024
MAX_TOKENS_REASONING_ON=8192
# Hard cap on cumulative live spend (USD), tracked in CACHE_DIR/spend.json.
# Check with `uv run python -m scripts.spend`. Raise deliberately (e.g. for the full eval).
MAX_SPEND_USD=0.50
LOG_LEVEL=INFO
