# Copy to .env and fill in. Never commit .env.
# Keep comments on their own lines (some env loaders don't strip inline comments).

# --- Nebius Token Factory (OpenAI-compatible) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# --- Model IDs ---
# Never hard-code these in code. Get the real IDs with:
#   uv run python -m scripts.list_models
# Nemotron 3 Nano: intake, outbreak extraction (use for all dev work)
MODEL_FAST=
# Nemotron 3 Super: compose / referral note
MODEL_MID=
# Nemotron 3 Ultra (or Super as fallback): reason step only
MODEL_REASON=
# Embedding model for the guideline index
MODEL_EMBED=

# Optional cost estimates: USD per 1M tokens, keyed by model ID (JSON).
# Example: {"<model-id>": {"input": 0.06, "output": 0.24}}
MODEL_PRICES={}

# --- Tavily ---
TAVILY_API_KEY=

# --- App ---
# dev | prod  (prod: disk cache off by default)
APP_ENV=dev
CACHE_DIR=.cache
# Defaults to true in dev, false in prod
# CACHE_ENABLED=true
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
LOG_LEVEL=INFO
